# Copy to backend/.env and adjust. Never commit the real .env.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/latestay
DB_USER=latestay
DB_PASSWORD=latestay
WEB_ORIGIN=http://localhost:3000
PORT=8080

# LLM for intent parsing and reply wording. Prices never come from it.
# LLM_PROVIDER: anthropic | openai (any OpenAI-compatible server) | none. Without a key, templates are used.
LLM_PROVIDER=none
# Defaults to claude-haiku-5-5 for anthropic; required for openai.
LLM_MODEL=
LLM_API_KEY=
# Optional: override the API base URL (e.g. a local OpenAI-compatible server, ending in /v1).
LLM_BASE_URL=

# Admin API (/api/admin/**, HTTP basic). Leave either empty to disable admin entirely.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Razorpay test-mode keys (dashboard.razorpay.com, Test Mode > API Keys). With the local profile and these empty,
# a fake gateway is used. The webhook secret is the one set on the dashboard webhook for
# payment.captured and refund.processed, pointing at <public url>/api/webhooks/razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Booking money in rupees: deposit = min(cap, agreed price); commission comes out of the deposit.
BOOKING_DEPOSIT_CAP=200
BOOKING_COMMISSION=100

# WhatsApp Business Cloud API (Meta app > WhatsApp > API setup). Owners get the nightly availability ping and
# booking requests here. Without WA_PHONE_NUMBER_ID / WA_ACCESS_TOKEN, messages are logged as NOT_SENT.
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# Any string you choose; enter the same one as the webhook's verify token in the Meta app.
WA_VERIFY_TOKEN=
# Meta app > App settings > Basic > App secret. Verifies X-Hub-Signature-256 on every webhook.
WA_APP_SECRET=
# Optional: Graph API version.
WA_GRAPH_VERSION=v23.0
