# Copy to backend/.env and adjust. Never commit the real .env.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/latestay
DB_USER=latestay
DB_PASSWORD=latestay
WEB_ORIGIN=http://localhost:3000
PORT=8080

# LLM for intent parsing and reply wording. Prices never come from it.
# LLM_PROVIDER: anthropic | openai (any OpenAI-compatible server) | none. Without a key, templates are used.
LLM_PROVIDER=none
# Defaults to claude-haiku-5-5 for anthropic; required for openai.
LLM_MODEL=
LLM_API_KEY=
# Optional: override the API base URL (e.g. a local OpenAI-compatible server, ending in /v1).
LLM_BASE_URL=

# Admin API (/api/admin/**, HTTP basic). Leave either empty to disable admin entirely.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Razorpay test-mode keys (dashboard.razorpay.com, Test Mode > API Keys). With the local profile and these empty,
# a fake gateway is used. The webhook secret is the one set on the dashboard webhook for
# payment.captured and refund.processed, pointing at <public url>/api/webhooks/razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Booking money in rupees: deposit = min(cap, agreed price); commission comes out of the deposit.
BOOKING_DEPOSIT_CAP=200
BOOKING_COMMISSION=100

# WhatsApp Business Cloud API (Meta app > WhatsApp > API setup). Owners get the nightly availability ping and
# booking requests here. Without WA_PHONE_NUMBER_ID / WA_ACCESS_TOKEN, messages are logged as NOT_SENT.
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# Any string you choose; enter the same one as the webhook's verify token in the Meta app.
WA_VERIFY_TOKEN=
# Meta app > App settings > Basic > App secret. Verifies X-Hub-Signature-256 on every webhook.
WA_APP_SECRET=
# Optional: Graph API version.
WA_GRAPH_VERSION=v23.0

# Errors to Sentry (free tier). Empty = off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# Razorpay live keys (rzp_live_...) are refused unless this is true. Leave false until KYC is done.
RAZORPAY_ALLOW_LIVE=false

# Phone verification (WhatsApp code before payment): HMAC key for stored hashes and the device cookie.
# 32+ random characters in production (openssl rand -base64 48). Empty = a development key (local only).
PHONE_VERIFICATION_SECRET=
# The admin's WhatsApp number for alerts ("guest turned away"), with country code.
ADMIN_WHATSAPP_NUMBER=
# LateStay support's WhatsApp number, linked from the traveller's booking_confirmed message. Empty = /contact.
SUPPORT_WHATSAPP_NUMBER=
# The web app's public URL, for links in WhatsApp messages (booking pass, owner sign-in). https in production.
PUBLIC_WEB_URL=http://localhost:3000
# A "turned away" dispute hides the hotel from search for this many hours, unless the admin keeps it hidden.
DISPUTE_HIDE_HOURS=6

# Owner page sign-in (WhatsApp "hisaab" link): HMAC key for the ls_owner cookie. 32+ random characters in
# production (openssl rand -base64 48). Empty = a development key (local only).
OWNER_SESSION_SECRET=

# Hotel photos: processed by the imaging service (imaging/), stored in S3-compatible storage (Cloudflare R2).
# Local: `docker compose up imaging photos` runs both; these defaults point at them.
IMAGING_URL=http://localhost:8081
# Same value as IMAGING_TOKEN for the imaging service. Empty locally.
IMAGING_TOKEN=
# R2: https://<account id>.r2.cloudflarestorage.com, an R2 API token's key pair, and the bucket's public URL
# (custom domain or r2.dev). Locally the S3Mock container below.
R2_ENDPOINT=http://localhost:9090
R2_BUCKET=latestay-photos
R2_ACCESS_KEY_ID=local
R2_SECRET_ACCESS_KEY=local
R2_PUBLIC_BASE_URL=http://localhost:9090/latestay-photos
# true for S3Mock; R2 works either way.
R2_PATH_STYLE=true

# Which environment this is: local, staging or production. Production never seeds data; staging takes Razorpay test
# keys only. (Staging also runs with SPRING_PROFILES_ACTIVE=prod,staging.)
APP_ENV=local
# Seeded hotels: on in the local and staging profiles; refused in production.
SEED_DATA=false

# LLM spend: the model's prices from the provider's price page (US dollars per million tokens), recorded per bot
# turn; the monthly budget after which replies come from the templates (0 = no limit here; set one at the
# provider too); and the rate for showing it in rupees.
LLM_PRICE_INPUT_PER_MTOK_USD=0
LLM_PRICE_OUTPUT_PER_MTOK_USD=0
LLM_MONTHLY_BUDGET_USD=0
USD_INR_RATE=88

# Analytics: events are always kept in our database (/admin/funnel); with a key they're also sent to PostHog from
# the server (never the browser), without IPs. Empty = not sent.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Pricing: 2 = occupancy, weekend and season (opening offers and concession speed only; floors never move);
# 1 = the rules before that. Friday and Saturday nights open at PRICING_WEEKEND_PERCENT.
PRICING_VERSION=2
PRICING_WEEKEND_PERCENT=110

# Reliability: a hotel is paused from search (until an admin reviews it) below this confirm rate once it has
# answered this many bookings in 30 days, or at this many rescues plus upheld disputes.
RELIABILITY_MIN_DECISIONS=3
RELIABILITY_MIN_CONFIRM_RATE=70
RELIABILITY_MAX_STRIKES=2

# true once the booking_request_rooms template is approved (two-room bookings).
WA_ROOMS_TEMPLATE=false

# App push notifications: the Firebase project's service account key, as one line of JSON (Firebase console >
# Project settings > Service accounts > Generate new private key). Empty: notifications are queued and marked
# NOT_SENT. One Firebase project per environment (docs/MOBILE.md).
FIREBASE_SERVICE_ACCOUNT_JSON=
