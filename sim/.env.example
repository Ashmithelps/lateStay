# Copy to sim/.env. Never commit the real file.
# Key for the persona LLM (not needed with --offline).
ANTHROPIC_API_KEY=
# Persona model; default claude-opus-5-5. claude-haiku-5-5 is far cheaper.
SIM_PERSONA_MODEL=claude-opus-5-5
# Model the backend uses (LLM_MODEL there), only for cost estimates.
SIM_BACKEND_MODEL=claude-haiku-5-5
SIM_BASE_URL=http://localhost:8080
