# Copy to web/.env.local and adjust. Never commit the real file. Every variable is documented in docs/DEPLOY.md.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Map tiles. Empty = OpenStreetMap's public tiles (fine for development only). For production, a provider URL with
# your key, e.g. MapTiler: https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
NEXT_PUBLIC_MAP_TILE_URL=
# HTML attribution the provider requires, e.g. &copy; MapTiler &copy; OpenStreetMap contributors
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Sentry (errors only). Empty = off. The browser uses NEXT_PUBLIC_SENTRY_DSN, the server SENTRY_DSN (same value).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# Shown on /privacy and /terms.
NEXT_PUBLIC_SUPPORT_EMAIL=
