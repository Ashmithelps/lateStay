<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (APNs through Firebase). Xcode switches this to production when archiving for the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links: /pass/* and /stay/* open in the app (web/src/app/.well-known/apple-app-site-association). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:latestay.in</string>
		<string>applinks:staging.latestay.in</string>
	</array>
</dict>
</plist>
